# Restricted SSH forwarding target. The matching authorized_keys entry on the
# isolated Session host must permit only 127.0.0.1:8091 forwarding.
SESSION_TUNNEL_TARGET=ubuntu@SESSION_HOST_IP
SESSION_TUNNEL_FORWARD=127.0.0.1:18091:127.0.0.1:8091
# Optional congestion-control relay, for example root@RELAY_IP:41012.
SESSION_TUNNEL_PROXY_JUMP=
