[Unit]
Description=Sub2API Session Delivery V2 Closed-Hour Export
After=network-online.target sub2api-sessiond.service xray-session-egress.service
Wants=network-online.target xray-session-egress.service

[Service]
Type=oneshot
User=sub2api
Group=sub2api
UMask=0077
WorkingDirectory=/opt/sub2api
EnvironmentFile=/etc/sub2api/session-delivery.env
# A drain can legitimately span many closed hours after an outage. Resource
# limits below remain the hard safety boundary while the longer timeout avoids
# terminating a verified Drive upload/read-back sequence mid-batch.
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
CPUQuota=150%
MemoryHigh=768M
MemoryMax=1152M
OOMPolicy=stop
ExecStart=/opt/sub2api/sessionctl export \
  -drain \
  -max-hours 48 \
  -archive-dir /var/lib/sub2api/session-delivery/archive \
  -temp-dir /var/lib/sub2api/session-delivery/export-tmp
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/sub2api/session-delivery
