[Unit]
Description=Sub2API Session Delivery V2 Spool Forwarder
After=network-online.target sub2api.service sub2api-session-tunnel.service
Wants=network-online.target sub2api-session-tunnel.service

[Service]
Type=simple
User=sub2api
Group=sub2api
UMask=0077
WorkingDirectory=/opt/sub2api
EnvironmentFile=/etc/sub2api/session-delivery.env
ExecStart=/opt/sub2api/sessionctl forward \
  -loop \
  -interval 5s \
  -spool-dir /opt/sub2api/data/session-delivery/spool
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/sub2api/data/session-delivery

[Install]
WantedBy=multi-user.target
