#!/usr/bin/env bash
set -euo pipefail

: "${SESSION_TUNNEL_TARGET:?SESSION_TUNNEL_TARGET is required}"

start_delay="${SESSION_TUNNEL_START_DELAY:-0}"
if [[ ! "${start_delay}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "SESSION_TUNNEL_START_DELAY must be a non-negative number of seconds" >&2
  exit 2
fi

forward_values="${SESSION_TUNNEL_FORWARDS:-${SESSION_TUNNEL_FORWARD:-}}"
if [[ -z "${forward_values}" ]]; then
  echo "SESSION_TUNNEL_FORWARDS or SESSION_TUNNEL_FORWARD is required" >&2
  exit 2
fi
IFS=',' read -r -a forwards <<<"${forward_values}"
if ((${#forwards[@]} == 0)); then
  echo "No Session tunnel forwards were configured" >&2
  exit 2
fi
for index in "${!forwards[@]}"; do
  forwards[index]="${forwards[index]//[[:space:]]/}"
  if [[ ! "${forwards[index]}" =~ ^[A-Za-z0-9._-]+:[0-9]+:[A-Za-z0-9._-]+:[0-9]+$ ]]; then
    echo "Invalid Session tunnel forward: ${forwards[index]}" >&2
    exit 2
  fi
done

proxy_jump=()
if [[ -n "${SESSION_TUNNEL_PROXY_JUMP:-}" ]]; then
  proxy_target="${SESSION_TUNNEL_PROXY_JUMP%:*}"
  proxy_port="${SESSION_TUNNEL_PROXY_JUMP##*:}"
  if [[ ! "${proxy_target}" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$ ||
        ! "${proxy_port}" =~ ^[0-9]+$ ||
        "${proxy_port}" -lt 1 || "${proxy_port}" -gt 65535 ]]; then
    echo "SESSION_TUNNEL_PROXY_JUMP must use user@host:port" >&2
    exit 2
  fi
  proxy_command="/usr/bin/ssh -i /var/lib/sub2api/session-delivery/private/session_tunnel_ed25519 -o BatchMode=yes -o IdentitiesOnly=yes -o IPQoS=none -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/var/lib/sub2api/session-delivery/private/ssh_known_hosts -p ${proxy_port} -W %h:%p ${proxy_target}"
  proxy_jump=(-o "ProxyCommand=${proxy_command}")
fi

pids=()
cleanup() {
  trap - EXIT TERM INT
  if ((${#pids[@]} > 0)); then
    kill "${pids[@]}" 2>/dev/null || true
    wait "${pids[@]}" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 0' TERM INT

for forward in "${forwards[@]}"; do
  /usr/bin/ssh \
    -NT \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o IPQoS=none \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile=/var/lib/sub2api/session-delivery/private/ssh_known_hosts \
    -i /var/lib/sub2api/session-delivery/private/session_tunnel_ed25519 \
    "${proxy_jump[@]}" \
    -L "${forward}" \
    "${SESSION_TUNNEL_TARGET}" &
  pids+=("$!")
  if [[ "${start_delay}" != "0" ]]; then
    sleep "${start_delay}"
  fi
done

set +e
wait -n "${pids[@]}"
exit_status=$?
set -e
exit "${exit_status}"
