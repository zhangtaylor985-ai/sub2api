[Unit]
Description=Sub2API Session Delivery V2 Tunnel Progress Watchdog
After=sub2api-session-tunnel.service
Wants=sub2api-session-tunnel.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/sub2api/session-tunnel-health
RuntimeDirectory=sub2api-session-tunnel-health
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/sub2api/data/session-delivery/spool/pending
